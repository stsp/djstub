#
# spec file for package djstub
#

Name: {{{ git_dir_name }}}
Version: {{{ git_dir_version }}}
Release: 1%{?dist}
Summary: advanced djgpp-compatible stub
BuildArch: noarch

Group: Development/Tools

License: GPLv3+
URL: https://github.com/stsp/djstub
VCS: {{{ git_dir_vcs }}}
Source0: {{{ git_dir_archive }}}

BuildRequires: make
BuildRequires: smallerc
Requires: python3

%description
djstub is a go32-compatible stub, with support of COFF, PE and ELF formats.
Can be used with djgpp and dj64 tool-chains.

%prep
{{{ git_dir_setup_macro }}}

%build
make prefix=%{_prefix}

%check

%define debug_package %{nil}

%install
make install DESTDIR=%{buildroot} prefix=%{_prefix}

%files
%defattr(-,root,root)
%{_bindir}/*
%{_datadir}/djstub2
%{_libexecdir}/djstub2
